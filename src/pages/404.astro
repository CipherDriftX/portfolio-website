---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";
import { siteContent } from "../lib/content";

const { sections } = await siteContent();
---

<Base title={`Page not found · ${site.name}`} description={site.claim} path="/404" sections={sections} noindex contact={false}>
  <section class="lost" aria-labelledby="lost-title">
    <div class="pool">
      <div class="frame">
        <h1 id="lost-title">There is no page at this address.</h1>
        <p><a href="/">Go to the home page</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* One lit pool in an empty hall. */
  .lost {
    display: grid;
    align-content: center;
    min-height: calc(100svh - var(--bar) - 4rem);
  }

  h1 {
    max-width: 18ch;
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.5rem);
    line-height: 1.08;
  }

  p {
    margin-block-start: 1.5rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 1.125rem;
  }
</style>
