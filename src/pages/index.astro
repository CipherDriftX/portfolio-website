---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import ContactLinks from "../components/ContactLinks.astro";
import Project from "../components/Project.astro";
import { site } from "../data/site";
import { shown, siteContent } from "../lib/content";

const { live, soon, sections, studies, projects, reviews, notes, about } = await siteContent();
const AboutBody = about ? (await render(about)).Content : null;

// Work comes in two lanes: agents that do a job, and tools that keep agents
// safe. A lane with no live projects does not show. Each lane shows its first
// few cards; the rest wait behind "View more".
const lanes = [
  { id: "agents", title: "Agentic Systems", line: "Agents that take a whole job from start to finish." },
  { id: "safety", title: "Agent safety", line: "Tools that test an agent before it ships and guard it while it runs." },
]
  .map((lane) => ({ ...lane, items: projects.filter((p) => p.data.lane === lane.id) }))
  .filter((lane) => lane.items.length > 0);

// Must match the layout switch in the styles below.
const DESK = "(min-width: 40rem) and (min-aspect-ratio: 5/4)";
const desk = (ext: string) => [640, 960, 1280, 1600].map((w) => `/photo/desk-${w}.${ext} ${w}w`).join(", ");
const phone = (ext: string) => [480, 720, 960].map((w) => `/photo/phone-${w}.${ext} ${w}w`).join(", ");
const date = (d: Date) => d.toISOString().slice(0, 10);

// Live projects for the SoftwareSourceCode schema. Drafts never reach it.
const code = projects
  .filter((p) => !p.data.draft)
  .map((p) => ({
    name: p.data.name,
    description: p.data.line,
    repo: p.data.repo,
    language: p.data.language,
    dateModified: date(p.data.updated),
  }));
---

<Base title={site.pageTitle} description={site.claim} path="/" sections={sections} onHome person code={code}>
  <section class="hero" aria-labelledby="name">
    <div class="light" aria-hidden="true">
      <span class="bloom amber"></span>
      <span class="bloom violet"></span>
      <span class="bloom blue"></span>
    </div>

    <picture class="photo">
      <source media={DESK} type="image/avif" srcset={desk("avif")} sizes="55vw" width="1600" height="2160" />
      <source media={DESK} type="image/webp" srcset={desk("webp")} sizes="55vw" width="1600" height="2160" />
      <source media={DESK} type="image/jpeg" srcset={desk("jpg")} sizes="55vw" width="1600" height="2160" />
      <source type="image/avif" srcset={phone("avif")} sizes="100vw" />
      <source type="image/webp" srcset={phone("webp")} sizes="100vw" />
      <img
        src="/photo/phone-720.jpg"
        srcset={phone("jpg")}
        sizes="100vw"
        width="960"
        height="1200"
        alt={site.photo.alt}
        fetchpriority="high"
      />
    </picture>

    <div class="intro frame">
      <h1 id="name"><span>Aryan</span> <span>Haghighi</span></h1>
      <p class="role">{site.title}</p>
      <p class="claim">{site.claim}</p>
      <p class="drone">{site.drone}</p>
      <ContactLinks label="Contact" class="hero-links" />
    </div>
  </section>

  <section id="problem" class="section chapter peek frame" aria-labelledby="problem-title">
    <h2 id="problem-title">The problem</h2>
    <div class="problem">
      <p class="statement">
        An AI agent can look perfect in a demo and still fail on real work. It gets the job wrong, leaks a key, or
        follows an order hidden in a web page.
      </p>
      <div class="answer plate">
        <p>
          I build both: agents that finish real work, and the tools that test them before they ship and guard them while
          they run.
        </p>
        {
          lanes.length > 0 && (
            <ul role="list" class="jump">
              {lanes.map((lane) => (
                <li>
                  <a href={`#${lane.id}`}>{lane.title}</a>
                  <span class="quiet">
                    <span class="num">{lane.items.length}</span> {lane.items.length === 1 ? "project" : "projects"}
                  </span>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>
  </section>

  {
    live.work && (
      <section id="work" class="section chapter frame" aria-labelledby="work-title">
        <h2 id="work-title">Work</h2>
        {projects.length > 0 && <p class="work-lead quiet">All public code. Every number below comes from its repo.</p>}
        {projects.length === 0 && (
          <p class="quiet empty">
            Selected projects go here soon. Until then, my code is on <a href={site.links.github}>GitHub</a>.
          </p>
        )}
        {lanes.map((lane) => (
          <div class:list={["lane", lane.id]} id={lane.id}>
            <div class="lane-head">
              <h3>{lane.title}</h3>
              <p class="quiet">{lane.line}</p>
            </div>
            <ol role="list" class="cards">
              {lane.items.map((p, i) => (
                <li class:list={{ first: i === 0, extra: i >= shown.projects }}>
                  <Project project={p} wide={i === 0} />
                </li>
              ))}
            </ol>
            {lane.items.length > shown.projects && (
              <details class="view-more">
                <summary>
                  <span class="closed">
                    View <span class="num">{lane.items.length - shown.projects}</span> more
                  </span>
                  <span class="opened">Show fewer</span>
                </summary>
              </details>
            )}
          </div>
        ))}
      </section>
    )
  }

  {
    live["case-studies"] && studies.length > 0 && (
      <section id="case-studies" class="section chapter frame" aria-labelledby="case-studies-title">
        <h2 id="case-studies-title">Case studies</h2>
        <ul role="list" class="studies">
          {studies.map((s, i) => (
            <li class:list={["study plate", { extra: i >= shown.studies }]}>
              <h3>
                <a href={`/work/${s.id}`}>{s.data.title}</a>
                {s.data.draft && <span class="draft-tag">Draft</span>}
              </h3>
              <p>{s.data.summary}</p>
              {s.data.evals && (
                <p class="eval">
                  <span class="num value">{s.data.evals.value}</span>
                  <span>
                    {s.data.evals.metric}, on <span class="num">{s.data.evals.cases}</span> eval{" "}
                    {s.data.evals.cases === 1 ? "case" : "cases"}
                  </span>
                </p>
              )}
              <p class="quiet">
                {s.data.clientType}, <span class="num">{s.data.year}</span>
              </p>
            </li>
          ))}
        </ul>
        {studies.length > shown.studies && (
          <details class="view-more">
            <summary>
              <span class="closed">
                View all <span class="num">{studies.length}</span>
              </span>
              <span class="opened">Show fewer</span>
            </summary>
          </details>
        )}
      </section>
    )
  }

  {
    live.reviews && (
      <section id="reviews" class="section chapter frame" aria-labelledby="reviews-title">
        <h2 id="reviews-title">Reviews</h2>
        <ul role="list" class="reviews">
          {reviews.map((r, i) => (
            <li class:list={{ extra: i >= shown.reviews }}>
              <figure>
                <blockquote>
                  <p>{r.data.quote}</p>
                </blockquote>
                <figcaption>
                  <a href={r.data.link}>{r.data.name}</a>, {r.data.role}, {r.data.company}
                  {r.data.draft && <span class="draft-tag">Draft</span>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
        {reviews.length > shown.reviews && (
          <details class="view-more">
            <summary>
              <span class="closed">
                View all <span class="num">{reviews.length}</span>
              </span>
              <span class="opened">Show fewer</span>
            </summary>
          </details>
        )}
      </section>
    )
  }

  {
    live.notes && notes.length > 0 && (
      <section id="notes" class="section chapter frame" aria-labelledby="notes-title">
        <h2 id="notes-title">Notes</h2>
        <ul role="list" class="notes">
          {notes.map((n, i) => (
            <li class:list={{ extra: i >= shown.notes }}>
              <time datetime={date(n.data.date)}>{date(n.data.date)}</time>
              <div>
                <h3>
                  <a href={`/notes/${n.id}`}>{n.data.title}</a>
                  {n.data.draft && <span class="draft-tag">Draft</span>}
                </h3>
                <p class="quiet">{n.data.summary}</p>
              </div>
            </li>
          ))}
        </ul>
        {notes.length > shown.notes && (
          <details class="view-more">
            <summary>
              <span class="closed">
                View all <span class="num">{notes.length}</span>
              </span>
              <span class="opened">Show fewer</span>
            </summary>
          </details>
        )}
      </section>
    )
  }

  {
    soon.length > 0 && (
      <div class="soon frame">
        {soon.map((id) => (
          <section id={id} class="soon-item" aria-labelledby={`${id}-title`}>
            <h2 id={`${id}-title`}>{id === "notes" ? "Notes" : "Case studies"}</h2>
            <p class="quiet">{id === "notes" ? "Notes go here soon." : "Case studies go here soon."}</p>
          </section>
        ))}
      </div>
    )
  }

  <div class="closing frame">
    {
      about && AboutBody && (
        <section id="about" class="chapter" aria-labelledby="about-title">
          <h2 id="about-title">
            About
            {about.data.draft && <span class="draft-tag">Draft</span>}
          </h2>
          <div class="about">
            <AboutBody />
          </div>
        </section>
      )
    }
    <section id="how" class="chapter" aria-labelledby="how-title">
      <h2 id="how-title">How I work</h2>
      <p class="offer plate">{site.offer}</p>
    </section>
  </div>
</Base>

<style>
  /* ---------- First screen, phones first ---------- */

  .hero {
    position: relative;
    isolation: isolate;
  }

  .photo {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 4 / 5;
    /* The photo gives way so the name, claim, links and the first section's
       heading fit on the first screen. On short screens (under about 740px)
       it keeps 46% of the height so the name stays clear of his face; the
       peek gives way there, the links never do. */
    max-height: max(14rem, min(64svh, max(calc(100svh - 25rem), 46svh)));
    overflow: hidden;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The crop has headroom above his hair; a shorter box trims the arms. */
    object-position: 50% 14%;
    /* No hard box: the bottom melts into the page, the top softens under
       the bar's own fade. */
    mask-image: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.35) 0%,
      rgb(0 0 0 / 0.8) 7%,
      #000 14%,
      #000 52%,
      rgb(0 0 0 / 0.75) 66%,
      rgb(0 0 0 / 0.35) 80%,
      rgb(0 0 0 / 0.1) 90%,
      transparent 100%
    );
    animation: fade 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .intro {
    position: relative;
    z-index: 2;
    margin-block-start: calc(-1 * clamp(3.5rem, 16vw, 6rem));
    animation: fade 600ms cubic-bezier(0.16, 1, 0.3, 1) 80ms both;
  }

  h1 {
    font-size: clamp(3.5rem, 15vw, 6rem);
    line-height: 0.95;
    letter-spacing: -0.01em;
  }

  h1 span {
    display: block;
  }

  .role {
    margin-block-start: 1.25rem;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 600;
    letter-spacing: 0.005em;
  }

  .claim {
    margin-block-start: 0.5rem;
    max-width: 28ch;
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.625rem);
    line-height: 1.35;
    text-wrap: balance;
  }

  .drone {
    margin-block-start: 0.875rem;
    color: var(--muted);
  }

  .intro :global(.hero-links) {
    margin-block-start: 1.75rem;
  }

  /* ---------- Light: three blooms, each from a real source ---------- */

  .light {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Blooms may spill down into the next section, never sideways: a page
       wider than the screen pans sideways on iOS even with body clipped. */
    overflow-x: clip;
  }

  .bloom {
    position: absolute;
    border-radius: 50%;
    /* grain inside the gradient only, masked to the same falloff */
    mask-image: radial-gradient(closest-side, #000 40%, transparent 100%);
  }

  .amber {
    display: none;
  }

  .violet {
    left: -30%;
    top: 34%;
    width: 110%;
    height: 50%;
    background:
      var(--grain-violet),
      radial-gradient(closest-side, rgb(210 115 173 / 0.16), rgb(210 115 173 / 0.05) 55%, transparent);
  }

  .blue {
    right: -35%;
    top: 40%;
    width: 90%;
    height: 40%;
    background:
      var(--grain-blue),
      radial-gradient(closest-side, rgb(48 33 215 / 0.26), rgb(48 33 215 / 0.08) 55%, transparent);
  }

  /* ---------- Desktop: photo right, text left ---------- */

  @media (min-width: 40rem) and (min-aspect-ratio: 5/4) {
    .hero {
      --pw: min(55vw, 82svh);
      display: grid;
      align-items: center;
      min-height: max(34rem, calc(100svh - 6rem));
      padding-block: 5rem 2rem;
    }

    .photo {
      position: absolute;
      top: 0;
      right: 0;
      width: var(--pw);
      height: 100svh;
      min-height: 36rem;
      max-height: none;
      aspect-ratio: auto;
    }

    .photo img {
      object-position: 50% 88%;
      /* Left edge melts toward the text, bottom into the next section,
         top softens under the bar. */
      mask-image:
        linear-gradient(
          to right,
          transparent 0%,
          rgb(0 0 0 / 0.08) 8%,
          rgb(0 0 0 / 0.25) 16%,
          rgb(0 0 0 / 0.5) 24%,
          rgb(0 0 0 / 0.78) 32%,
          #000 42%
        ),
        linear-gradient(
          to bottom,
          rgb(0 0 0 / 0.55) 0%,
          #000 14%,
          #000 72%,
          rgb(0 0 0 / 0.6) 84%,
          rgb(0 0 0 / 0.2) 93%,
          transparent 100%
        );
      mask-composite: intersect;
    }

    .intro {
      margin-block-start: 0;
    }

    /* The name fills the dark side, never the photo. */
    h1 {
      font-size: clamp(2.5rem, min((100vw - var(--pw)) / 5.2, 13svh), 6rem);
    }

    .intro > * {
      max-width: min(40rem, calc(100vw - var(--pw) - var(--gutter)));
    }

    .claim {
      max-width: min(30ch, calc(100vw - var(--pw) - var(--gutter)));
    }

    .amber {
      display: block;
      right: calc(var(--pw) * 0.05);
      top: -38svh;
      width: calc(var(--pw) * 1.5);
      height: 80svh;
      background:
        var(--grain-amber),
        radial-gradient(closest-side, rgb(247 188 124 / 0.13), rgb(247 188 124 / 0.04) 55%, transparent);
    }

    .violet {
      left: auto;
      right: calc(var(--pw) * 0.3);
      top: 8svh;
      width: calc(var(--pw) * 1.25);
      height: 72svh;
    }

    .blue {
      right: calc(var(--pw) * -0.3);
      top: 62svh;
      width: calc(var(--pw) * 0.9);
      height: 56svh;
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  /* ---------- Sections: chapters of one story ---------- */

  .hero {
    counter-reset: chapter;
  }

  .section,
  .soon,
  .closing {
    position: relative;
    z-index: 2;
    padding-block-start: var(--step-section);
  }

  .section.peek {
    padding-block-start: clamp(2rem, 1rem + 4vw, 5rem);
  }

  /* Short phones: no room for a clean peek, so the heading starts fully
     below the fold instead of showing as a sliver. */
  @media (max-height: 45rem) {
    .section.peek {
      padding-block-start: var(--step-section);
    }
  }

  @media (min-width: 40rem) and (min-aspect-ratio: 5/4) {
    .section.peek {
      padding-block-start: 1.5rem;
    }
  }

  /* Each chapter opens on a hairline with its number in the mark's tan,
     the same way the drawings number their steps. */
  .chapter {
    counter-increment: chapter;
  }

  .chapter > h2 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 1rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--rule);
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    margin-block-end: 1.5rem;
  }

  .chapter > h2::before {
    content: counter(chapter, decimal-leading-zero);
    color: var(--tan);
    font-family: var(--text);
    font-size: 1rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums lining-nums;
    letter-spacing: 0.04em;
  }

  .quiet {
    color: var(--muted);
  }

  h3 {
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    line-height: 1.15;
  }

  h3 a {
    text-decoration-color: transparent;
  }

  h3 a:hover,
  h3 a:focus-visible {
    text-decoration-color: var(--amber);
  }

  /* ---------- The problem, and the answer on a raised plate ---------- */

  .problem {
    display: grid;
    gap: 2rem;
  }

  .statement {
    max-width: 30ch;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    line-height: 1.3;
    text-wrap: balance;
  }

  .answer {
    padding: clamp(1.25rem, 1rem + 1.25vw, 2rem);
  }

  .answer > p {
    max-width: 36ch;
    font-size: 1.125rem;
    line-height: 1.5;
  }

  .jump {
    margin-block-start: 1.25rem;
  }

  .jump li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1rem;
    min-height: 3rem;
    border-block-start: 1px solid var(--rule);
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 600;
  }

  .jump .quiet {
    font-size: 0.9375rem;
  }

  @media (min-width: 64rem) {
    .problem {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      align-items: end;
      gap: clamp(3rem, 2rem + 3vw, 6rem);
    }
  }

  /* ---------- Work: two lanes of cards, each lit by its own light ---------- */

  .work-lead {
    max-width: var(--measure);
  }

  .lane {
    position: relative;
    isolation: isolate;
    margin-block-start: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    scroll-margin-block-start: 1.5rem;
  }

  .lane + .lane {
    margin-block-start: clamp(4rem, 3rem + 3vw, 6rem);
  }

  /* The light behind the cards: bulb amber over the agents, the neon's
     violet over the safety tools. Faint, dithered, never ink. */
  .lane::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: -5rem 0 -3rem;
    pointer-events: none;
    mask-image: radial-gradient(closest-side, #000 40%, transparent 100%);
  }

  .lane.agents::before {
    background:
      var(--grain-amber),
      radial-gradient(closest-side, rgb(247 188 124 / 0.09), rgb(247 188 124 / 0.03) 55%, transparent);
  }

  .lane.safety::before {
    background:
      var(--grain-violet),
      radial-gradient(closest-side, rgb(210 115 173 / 0.11), rgb(210 115 173 / 0.035) 55%, transparent);
  }

  .lane-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.25rem;
    margin-block-end: 1.25rem;
  }

  .lane-head p {
    font-size: 0.9375rem;
  }

  /* Phones: one column. From 48rem: the lane's first card runs full width,
     the rest sit two to a row with their parts lined up. */
  .cards {
    container-type: inline-size;
    display: grid;
    gap: clamp(1rem, 0.75rem + 1vw, 1.5rem);
    margin: 0;
  }

  .cards > li {
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 0;
    min-width: 0;
  }

  .cards > li.first {
    display: block;
    grid-row: auto;
  }

  @media (min-width: 48rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .cards > li.first {
      grid-column: 1 / -1;
    }
  }

  /* ---------- View more: extra entries wait until asked for ---------- */

  :is(.cards, .studies, .reviews, .notes):has(+ .view-more:not([open])) > .extra {
    display: none;
  }

  .view-more {
    margin-block-start: clamp(1rem, 0.75rem + 1vw, 1.5rem);
  }

  .view-more summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-height: 3rem;
    border: 1px solid var(--rule);
    cursor: pointer;
    list-style: none;
    font-size: 0.9375rem;
    font-weight: 600;
    transition:
      color 120ms ease-out,
      border-color 120ms ease-out;
  }

  .view-more summary::-webkit-details-marker {
    display: none;
  }

  .view-more summary:hover {
    color: var(--amber);
    border-color: var(--amber);
  }

  .view-more[open] .closed,
  .view-more:not([open]) .opened {
    display: none;
  }

  /* ---------- Case studies, reviews, notes ---------- */

  .studies {
    display: grid;
    gap: clamp(1rem, 0.75rem + 1vw, 1.5rem);
  }

  @media (min-width: 48rem) {
    .studies {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .study {
    padding: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
  }

  .study p {
    margin-block-start: 0.5rem;
    max-width: var(--measure);
  }

  .eval {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }

  .study .eval {
    margin-block-start: 1.25rem;
  }

  .value {
    font-family: var(--text);
    font-size: 1.625rem;
    font-weight: 600;
    color: var(--cream);
  }

  .reviews {
    display: grid;
    gap: 3rem;
    max-width: 48rem;
  }

  blockquote p {
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.625rem);
    line-height: 1.4;
  }

  figcaption {
    margin-block-start: 1rem;
    color: var(--muted);
  }

  .notes {
    display: grid;
    gap: 2rem;
    max-width: 52rem;
  }

