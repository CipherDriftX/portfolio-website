---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import ContactLinks from "../components/ContactLinks.astro";
import { site } from "../data/site";
import { siteContent } from "../lib/content";

const { live, first, sections, studies, projects, reviews, notes, about } = await siteContent();
const AboutBody = about ? (await render(about)).Content : null;

// Must match the layout switch in the styles below.
const WIDE = "(min-width: 40rem) and (min-aspect-ratio: 5/4)";
const print = (ext: string) => [480, 720, 960, 1280, 1600].map((w) => `/photo/print-${w}.${ext} ${w}w`).join(", ");
const sizes = `${WIDE} 56vw, 100vw`;
const date = (d: Date) => d.toISOString().slice(0, 10);
---

<Base title={site.pageTitle} description={site.claim} path="/" sections={sections} onHome person>
  <section class="hero" aria-labelledby="name">
    <!-- The spot's edge: the jet's leading edge, from nose to wingtip, drawn
         at the size of the room. Wide screens light the right side, tall
         screens the top. -->
    <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
      <clipPath id="beam-wide" clipPathUnits="objectBoundingBox">
        <path d="M0.357 0H1V1H0C0.24 0.595 0.321 0.317 0.357 0Z"></path>
      </clipPath>
      <clipPath id="beam-tall" clipPathUnits="objectBoundingBox">
        <path d="M0.32 0H1V1H0C0.215 0.595 0.287 0.317 0.32 0Z"></path>
      </clipPath>
    </svg>

    <picture class="print">
      <source type="image/avif" srcset={print("avif")} sizes={sizes} />
      <source type="image/webp" srcset={print("webp")} sizes={sizes} />
      <img
        src="/photo/print-960.jpg"
        srcset={print("jpg")}
        sizes={sizes}
        width="1600"
        height="2000"
        alt={site.photo.alt}
        fetchpriority="high"
      />
    </picture>

    <!-- The hall's one object: the site mark, hung nose up, leaning toward the spot. -->
    <div class="hang" aria-hidden="true">
      <svg class="jet" viewBox="-2.7 0.3 20 31.7" focusable="false">
        <g transform="rotate(15 10 16)">
          <path class="shade" d="M10 0C9 8 6.8 15 0.2 25.2L0.2 27.6L5.5 26.3L6.7 31.4L10 29.3Z"></path>
          <path class="lit" d="M10 0C11 8 13.2 15 19.8 25.2L19.8 27.6L14.5 26.3L13.3 31.4L10 29.3Z"></path>
        </g>
      </svg>
    </div>

    <div class="label frame">
      <h1 id="name"><span>Aryan</span> <span>Haghighi</span></h1>
      <p class="role">{site.title}</p>
      <p class="claim">{site.claim}</p>
      <p class="drone">{site.drone}</p>
      <ContactLinks label="Contact" class="hero-links" />
    </div>
  </section>

  {
    live.work && (
      <section id="work" class:list={["pool", first === "work" ? "first" : "walk"]} aria-labelledby="work-title">
        <div class="frame">
          <h2 id="work-title" class="wall">Work</h2>
          <ul role="list" class="row">
            {projects.map((p) => (
              <li class="exhibit">
                <h3>
                  <a href={p.data.repo}>{p.data.name}</a>
                  {p.data.draft && <span class="draft-tag">Draft</span>}
                </h3>
                <p>{p.data.line}</p>
                <p class="quiet">{p.data.why}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    live["case-studies"] && (
      <section
        id="case-studies"
        class:list={["pool", first === "case-studies" ? "first" : "walk"]}
        aria-labelledby="case-studies-title"
      >
        <div class="frame">
          <h2 id="case-studies-title" class="wall">Case studies</h2>
          <ul role="list" class="row">
            {studies.map((s) => (
              <li class="exhibit">
                <h3>
                  <a href={`/work/${s.id}`}>{s.data.title}</a>
                  {s.data.draft && <span class="draft-tag">Draft</span>}
                </h3>
                <p class="quiet">
                  {s.data.clientType}, <span class="num">{s.data.year}</span>
                </p>
                <p>{s.data.summary}</p>
                <p class="eval">
                  <span class="num value">{s.data.evals.value}</span>
                  <span>
                    {s.data.evals.metric}, on <span class="num">{s.data.evals.cases}</span> eval {s.data.evals.cases === 1 ? "case" : "cases"}
                  </span>
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section id="how" class:list={["pool how", first === "how" ? "first" : "walk"]} aria-labelledby="how-title">
    <div class="frame">
      <h2 id="how-title" class="wall">How I work</h2>
      <p class="offer">{site.offer}</p>
    </div>
  </section>

  {
    live.reviews && (
      <section id="reviews" class="pool walk" aria-labelledby="reviews-title">
        <div class="frame">
          <h2 id="reviews-title" class="wall">Reviews</h2>
          <ul role="list" class="row">
            {reviews.map((r) => (
              <li class="exhibit">
                <figure>
                  <blockquote>
                    <p>{r.data.quote}</p>
                  </blockquote>
                  <figcaption>
                    <a href={r.data.link}>{r.data.name}</a>, {r.data.role}, {r.data.company}
                    {r.data.draft && <span class="draft-tag">Draft</span>}
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    live.notes && (
      <section id="notes" class="pool walk" aria-labelledby="notes-title">
        <div class="frame">
          <h2 id="notes-title" class="wall">Notes</h2>
          <ul role="list" class="row">
            {notes.map((n) => (
              <li class="exhibit">
                <h3>
                  <a href={`/notes/${n.id}`}>{n.data.title}</a>
                  {n.data.draft && <span class="draft-tag">Draft</span>}
                </h3>
                <p class="quiet">
                  <time datetime={date(n.data.date)}>{date(n.data.date)}</time>
                </p>
                <p>{n.data.summary}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    about && AboutBody && (
      <section id="about" class="pool walk" aria-labelledby="about-title">
        <div class="frame">
          <h2 id="about-title" class="wall">
            About
            {about.data.draft && <span class="draft-tag">Draft</span>}
          </h2>
          <div class="about">
            <AboutBody />
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  /* ---------- First screen, phones first ---------- */

  .hero {
    position: relative;
    isolation: isolate;
  }

  .defs {
    position: absolute;
  }

  /* The print: his photo in black and white, cut out of the dark by the
     spot's edge. Hard edges all round; the light is on or off. */
  .print {
    position: relative;
    height: max(12.5rem, min(44svh, calc(100svh - 30rem)));
    overflow: clip;
    clip-path: url(#beam-tall);
  }

  .print img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* The crop has headroom above his hair; a shorter box trims the arms.
       Phones: a little closer in, anchored left, so his face clears the
       spot's edge. */
    object-position: 50% 20%;
    scale: 1.1;
    transform-origin: 0% 20%;
    animation: print-on 1ms steps(1, end) 280ms both;
  }

  .hang {
    position: absolute;
    top: 0.5rem;
    left: var(--gutter);
    height: clamp(5rem, 22vw, 7.5rem);
  }

  .jet {
    height: 100%;
    width: auto;
    aspect-ratio: 20 / 31.7;
  }

  .jet .shade {
    fill: var(--shade);
  }

  .jet .lit {
    fill: var(--steel);
    animation: facet-on 1ms steps(1, end) 100ms both;
  }

  /* The museum label: name, role, claim, drone line, then the links. */
  .label {
    padding-block-start: 1.5rem;
    animation: label-on 1ms steps(1, end) 460ms both;
  }

  h1 {
    font-size: clamp(2.25rem, 11.5vw, 4rem);
    line-height: 0.94;
    text-transform: uppercase;
  }

  h1 span {
    display: block;
  }

  .role {
    margin-block-start: 1rem;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem);
    font-weight: 600;
  }

  .claim {
    margin-block-start: 0.375rem;
    max-width: 28ch;
    font-size: clamp(1.1875rem, 1.05rem + 0.6vw, 1.5rem);
    line-height: 1.35;
    text-wrap: balance;
  }

  .drone {
    margin-block-start: 0.75rem;
    color: var(--muted);
  }

  .label :global(.hero-links) {
    margin-block-start: 1.25rem;
  }

  /* ---------- Wide screens: the spot lights the right, the label sits left ---------- */

  @media (min-width: 40rem) and (min-aspect-ratio: 5/4) {
    .hero {
      /* The first bay shows its lit edge and its whole title at the fold. */
      --peek: calc(1.75rem + clamp(2rem, 0.75rem + 3.6vw, 4.25rem));
      /* Where the spot's edge lands on the floor: the label stays left of it. */
      --edge: 44vw;
      --frame-left: max(var(--gutter), calc((100vw - 82rem) / 2 + var(--gutter)));
      display: flex;
      flex-direction: column;
      min-height: max(30rem, calc(100svh - var(--bar) - var(--peek)));
      padding-block-end: 3rem;
    }

    .print {
      position: absolute;
      inset: 0 0 1.5rem var(--edge);
      height: auto;
      clip-path: url(#beam-wide);
    }

    .print img {
      object-position: 50% 28%;
      scale: none;
    }

    /* Hung high on the left, filling the dark above the label. */
    .hang {
      position: relative;
      inset: auto;
      flex: 1 1 0;
      min-height: 7rem;
      max-height: 26rem;
      margin: clamp(0.75rem, 3svh, 2rem) 0 clamp(1.5rem, 4svh, 2.5rem) var(--frame-left);
    }

    .label {
      padding-block-start: 0;
    }

    .label > * {
      max-width: calc(var(--edge) - var(--frame-left) - 2.5rem);
    }

    /* The name may run past the floor line: higher up, the spot's edge
       leans away to the right, so the name never reaches the light. */
    .label > h1 {
      max-width: none;
      font-size: clamp(2.5rem, min(5.6vw, 10.5svh), 6rem);
    }

    .claim {
      max-width: min(26ch, calc(var(--edge) - var(--frame-left) - 2.5rem));
    }
  }

  /* Landscape phones: the label alone fits under 32rem; the jet waits. */
  @media (min-width: 40rem) and (min-aspect-ratio: 5/4) and (max-height: 32rem) {
    .hero {
      min-height: calc(100svh - var(--bar));
      padding-block-end: 1rem;
    }

    .hang {
      display: none;
    }

    .role {
      margin-block-start: 0.5rem;
    }

    .drone {
      margin-block-start: 0.375rem;
    }

    .label :global(.hero-links) {
      margin-block-start: 0.5rem;
    }
  }

  /* ---------- Lights up: jet, print, label, then the first bay. Hard cuts,
     all on by 600 ms; every state is readable. ---------- */

  @keyframes facet-on {
    from {
      fill: var(--shade);
    }
  }

  @keyframes print-on {
    from {
      filter: brightness(0.3);
    }
  }

  @keyframes label-on {
    from {
      color: var(--muted);
    }
  }

  @keyframes bay-on {
    from {
      background-color: var(--hall);
    }
  }

  /* ---------- Bays ---------- */

  .pool.first {
    padding-block-start: 1.25rem;
    animation: bay-on 1ms steps(1, end) 560ms both;
  }

  /* Short phones: no room for the whole title, so only the lit edge shows
     at the fold and the title starts below it, never as a sliver. */
  @media (max-height: 45rem) and (not ((min-width: 40rem) and (min-aspect-ratio: 5/4))) {
    .pool.first {
      padding-block-start: 3rem;
    }
  }

  /* How I work is the hall's one big move: its title and offer are set
     larger than every other bay. */
  .how .wall {
    font-size: clamp(2rem, 0.75rem + 3.6vw, 4.25rem);
    margin-block-end: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .offer {
    max-width: 30ch;
    font-size: clamp(1.3125rem, 1rem + 1.1vw, 2.125rem);
    line-height: 1.35;
  }

  .quiet {
    color: var(--muted);
  }

  /* Exhibits stand in one row; every label has the same lines in the same
     order: title, kind and year, text. */
  .row {
    display: grid;
    gap: 2.5rem 3rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }

  .exhibit h3 {
    font-size: 1.1875rem;
  }

  .exhibit h3 a {
    text-decoration-color: transparent;
  }

  .exhibit h3 a:hover,
  .exhibit h3 a:focus-visible {
    text-decoration-color: var(--heat);
  }

  .exhibit p {
    margin-block-start: 0.375rem;
    max-width: var(--measure);
  }

  .eval {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }

  .exhibit .eval {
    margin-block-start: 1rem;
  }

  .value {
    font-size: 1.625rem;
    font-weight: 600;
  }

  blockquote p {
    font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.4375rem);
    line-height: 1.4;
  }

  figcaption {
    margin-block-start: 1rem;
    color: var(--muted);
  }

  .about {
    max-width: var(--measure);
    font-size: 1.125rem;
  }
</style>
