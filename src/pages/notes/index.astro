---
// /notes/: every note, newest first. Kept out of search (noindex, not in the
// sitemap) until the first note is live, so engines never see an empty page.
import Base from "../../layouts/Base.astro";
import { notes, siteContent } from "../../lib/content";
import { site } from "../../data/site";

const { sections } = await siteContent();
const list = await notes();
const live = list.filter((n) => !n.data.draft);
const iso = (d: Date) => d.toISOString().slice(0, 10);
const description = `Notes by ${site.name} on AI agents in production, evals and agent safety.`;
---

<Base
  title={`Notes · ${site.name}`}
  description={description}
  path="/notes/"
  sections={sections}
  noindex={live.length === 0}
  schema={{
    "@type": "Blog",
    "@id": `${site.url}/notes/#blog`,
    name: `${site.name}: Notes`,
    description,
    blogPost: live.map((n) => ({
      "@type": "BlogPosting",
      headline: n.data.title,
      description: n.data.summary,
      url: `${site.url}/notes/${n.id}/`,
      datePublished: iso(n.data.date),
    })),
  }}
  breadcrumbs={[
    { name: site.name, path: "/" },
    { name: "Notes", path: "/notes/" },
  ]}
>
  <div class="glow" aria-hidden="true"></div>
  <section class="page frame" aria-labelledby="notes-title">
    <a class="back" href="/">{site.name}</a>
    <h1 id="notes-title">Notes</h1>
    <p class="lead">{description}</p>
    <p class="feed"><a href="/rss.xml">RSS feed</a></p>

    {list.length === 0 && <p class="quiet empty">Notes go here soon.</p>}
    <ol role="list" class="list">
      {
        list.map((n) => (
          <li>
            <time datetime={iso(n.data.date)}>{iso(n.data.date)}</time>
            <div>
              <h2>
                <a href={`/notes/${n.id}/`}>{n.data.title}</a>
                {n.data.draft && <span class="draft-tag">Draft</span>}
              </h2>
              <p class="quiet">{n.data.summary}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .page {
    position: relative;
    z-index: 1;
    padding-block: clamp(6rem, 4rem + 6vw, 9rem) 0;
  }

  .back,
  .feed a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
  }

  .back {
    color: var(--muted);
  }

  .back:hover {
    color: var(--amber);
  }

  h1 {
    margin-block-start: 1.5rem;
    font-size: clamp(2.5rem, 1.8rem + 3.5vw, 4.5rem);
  }

  .lead {
    max-width: 36ch;
    margin-block-start: 1rem;
    font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.375rem);
    line-height: 1.45;
  }

  .feed {
    margin-block-start: 0.5rem;
  }

  .quiet {
    color: var(--muted);
  }

  .empty {
    margin-block-start: 3rem;
  }

  .list {
    display: grid;
    gap: 2rem;
    max-width: 52rem;
    margin-block-start: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .list:empty {
    display: none;
  }

  .list li {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--rule);
  }

  .list time {
    color: var(--muted);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums lining-nums;
    padding-block-start: 0.3rem;
  }

  h2 {
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    line-height: 1.15;
  }

  h2 a {
    text-decoration-color: transparent;
  }

  h2 a:hover,
  h2 a:focus-visible {
    text-decoration-color: var(--amber);
  }

  .list p {
    margin-block-start: 0.375rem;
  }

  @media (min-width: 40rem) {
    .list li {
      grid-template-columns: 7rem 1fr;
    }
  }
</style>
