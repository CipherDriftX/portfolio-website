---
// /cv/: the CV as a page. The same words as the two PDFs (both printed from
// src/data/cv.ts by `npm run cv`), but every project links to its own page
// here, and it reads on a phone. Read mode, like a project page: the title,
// the summary as the lead, the PDFs, then one part per section.
import Page from "../layouts/Page.astro";
import { site } from "../data/site";
import { cv, type CvItem } from "../data/cv";
import { inline } from "../lib/cv-text";
import { personId } from "../lib/schema";

const path = "/cv/";
const updated = new Date(`${cv.updated}T00:00:00Z`).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const pdfs = [
  { href: "/cv.pdf", label: "US Letter, no photo" },
  { href: "/cv-a4.pdf", label: "A4, with photo" },
];
const parts: { id: string; title: string; items: CvItem[] }[] = [
  { id: "experience", title: "Experience", items: cv.experience },
  { id: "open-source", title: "Open source", items: cv.projects },
  { id: "education", title: "Education", items: cv.education },
];
const description = `CV of ${site.name}, AI engineer in Istanbul: production agentic systems and evals, AI security, and research on drone world models. PDF in US Letter and A4.`;
---

<Page
  title={`CV · ${site.name}`}
  description={description}
  path={path}
  schema={{
    "@type": "WebPage",
    about: { "@id": personId },
    mainEntity: { "@id": personId },
    dateModified: cv.updated,
    associatedMedia: pdfs.map((p) => ({
      "@type": "DigitalDocument",
      name: `${site.name}, CV (${p.label})`,
      encodingFormat: "application/pdf",
      url: `${site.url}${p.href}`,
    })),
  }}
  image={{ path: "/og/cv.png", alt: `${site.name}, CV: ${site.title} · ${cv.headline}` }}
  breadcrumbs={[
    { name: site.name, path: "/" },
    { name: "CV", path },
  ]}
>
  <article class="cv" aria-labelledby="cv-title">
    <header>
      <h1 id="cv-title" class="page-title">CV</h1>
      <p class="meta">
        <span>{site.title}</span>
        <span>Updated <time datetime={cv.updated}>{updated}</time></span>
      </p>
      <p class="page-lead" set:html={inline(cv.summary)} />
      <p class="pdfs">
        <span class="label">PDF</span>
        {pdfs.map((p) => <a href={p.href}>{p.label}</a>)}
      </p>
    </header>

    {
      parts.map((part) => (
        <section class="part" aria-labelledby={`${part.id}-title`}>
          <h2 id={`${part.id}-title`}>{part.title}</h2>
          <div class="body">
            {part.items.map((it) => (
              <div class="item">
                <h3 set:html={inline(it.title)} />
                <p class="where">
                  <span set:html={inline(it.org)} />
                  <span class="when">{it.when}</span>
                </p>
                {it.blurb && <p class="blurb" set:html={inline(it.blurb)} />}
                {it.stack && <p class="stack">{it.stack}</p>}
                {it.bullets.length > 0 && (
                  <ul role="list" class="bullets">
                    {it.bullets.map((b) => (
                      <li set:html={inline(b)} />
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </section>
      ))
    }

    <section class="part" aria-labelledby="honors-title">
      <h2 id="honors-title">Robotics honors</h2>
      <div class="body">
        <ul role="list" class="bullets">
          {cv.honors.map((h) => <li set:html={inline(h)} />)}
        </ul>
      </div>
    </section>

    <section class="part" aria-labelledby="skills-title">
      <h2 id="skills-title">Skills</h2>
      <div class="body">
        <dl class="skills">
          {
            cv.skills.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>
  </article>
</Page>

<style>
  /* ---------- Head: title, the line under it, the summary, the PDFs ---------- */
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.875rem;
    margin-block-start: 0.875rem;
    color: var(--muted);
  }

  /* The summary is three sentences, longer than a project's one line. */
  .cv :global(.page-lead) {
    max-width: 46ch;
  }

  .page-lead :global(b) {
    font-weight: 600;
  }

  .pdfs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.5rem;
    margin-block-start: 1rem;
  }

  .pdfs .label {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .pdfs a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  /* ---------- Parts: the heading on the left, the text on the right ---------- */
  .part {
    display: grid;
    gap: 1rem;
    margin-block-start: clamp(3rem, 2.25rem + 3vw, 5rem);
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--rule);
  }

  .part > h2 {
    font-size: clamp(1.625rem, 1.4rem + 0.8vw, 2rem);
  }

  .body {
    min-width: 0;
    max-width: var(--measure);
  }

  @media (min-width: 64rem) {
    .part {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 1rem clamp(2rem, 1rem + 3vw, 5rem);
    }
  }

  /* ---------- One job, school or project ---------- */
  .item + .item {
    margin-block-start: 2rem;
  }

  .item h3 {
    font-family: var(--text);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .where {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.875rem;
    margin-block-start: 0.25rem;
  }

  .when,
  .blurb,
  .stack {
    color: var(--muted);
  }

  .when {
    font-variant-numeric: tabular-nums lining-nums;
  }

  .blurb,
  .stack {
    margin-block-start: 0.25rem;
    font-size: 0.9375rem;
  }

  .blurb :global(a) {
    color: var(--cream);
  }

  /* Links inside the text: a 44px tap height without moving the lines.
     The hit area grows above and below the words; the focus ring stays on them. */
  .body :global(a) {
    position: relative;
  }

  .body :global(a)::after {
    content: "";
    position: absolute;
    inset: -0.75rem 0;
  }

  /* Small square markers in the muted ink: amber is only for links. */
  .bullets {
    display: grid;
    gap: 0.5rem;
    margin-block-start: 0.75rem;
  }

  .bullets li {
    position: relative;
    padding-inline-start: 1.125rem;
  }

  .bullets li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0.125rem;
    top: 0.7em;
    width: 0.3125rem;
    height: 0.3125rem;
    background: var(--muted);
  }

  .bullets :global(b) {
    font-weight: 600;
  }

  /* ---------- Skills: the label above the value, side by side when there is room ---------- */
  .skills > div {
    padding-block: 0.75rem;
    border-block-start: 1px solid var(--rule);
  }

  .skills > div:first-child {
    padding-block-start: 0;
    border-block-start: 0;
  }

  .skills dt {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  @media (min-width: 40rem) {
    .skills > div {
      display: grid;
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: 0 1rem;
      align-items: baseline;
    }
  }
</style>
