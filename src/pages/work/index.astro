---
// /work/: every project in its lane, each card opening the project's own
// page, then the case studies once there are any.
import Page from "../../layouts/Page.astro";
import Lanes from "../../components/Lanes.astro";
import { workPages } from "../../lib/content";
import { site } from "../../data/site";

const { studies, projects } = await workPages();
const live = projects.filter((p) => !p.data.draft);
const names = live.slice(0, 6).map((p) => p.data.name);
const list =
  names.length > 1 ? `${names.slice(0, -1).join(", ")} and ${names.at(-1)}${live.length > 6 ? ", among others" : ""}` : names[0];
const description = list
  ? `AI agents and agent safety tools by ${site.name}: ${list}. All public code.`
  : `AI agents and agent safety tools by ${site.name}.`;
const date = (d: Date) => d.toISOString().slice(0, 10);
const code = live.map((p) => ({
  name: p.data.name,
  description: p.data.line,
  repo: p.data.repo,
  path: `/work/${p.id}/`,
  language: p.data.language,
  dateModified: date(p.data.updated),
}));
---

<Page
  title={`Work · ${site.name}`}
  description={description}
  path="/work/"
  code={code}
  schema={{ "@type": "CollectionPage", mainEntity: { "@id": `${site.url}/work/#work` } }}
  breadcrumbs={[
    { name: site.name, path: "/" },
    { name: "Work", path: "/work/" },
  ]}
>
  <header>
    <h1 class="page-title">Work</h1>
    <p class="page-lead">All public code. Every number below comes from its repo.</p>
  </header>

  {projects.length === 0 && (
    <p class="quiet empty">
      Selected projects go here soon. Until then, my code is on <a href={site.links.github}>GitHub</a>.
    </p>
  )}
  <Lanes projects={projects} level="h2" />

  {
    studies.length > 0 && (
      <section class="studies" aria-labelledby="studies-title">
        <h2 id="studies-title">Case studies</h2>
        <ul role="list">
          {studies.map((s) => (
            <li>
              <h3>
                <a href={`/work/${s.id}/`}>{s.data.title}</a>
                {s.data.draft && <span class="draft-tag">Draft</span>}
              </h3>
              <p class="quiet">{s.data.summary}</p>
              <p class="quiet small">
                {s.data.clientType}, <span class="num">{s.data.year}</span>
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Page>

<style>
  header {
    margin-block-end: clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }

  .quiet {
    color: var(--muted);
  }

  .empty {
    margin-block-start: 2.5rem;
  }

  .studies {
    margin-block-start: clamp(4rem, 3rem + 3vw, 6rem);
  }

  .studies > h2 {
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--rule);
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
  }

  .studies ul {
    display: grid;
    gap: 2rem;
    max-width: 52rem;
    margin-block-start: 1.5rem;
  }

  .studies h3 {
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    line-height: 1.15;
  }

  .studies h3 a {
    text-decoration-color: transparent;
  }

  .studies h3 a:hover,
  .studies h3 a:focus-visible {
    text-decoration-color: var(--amber);
  }

  .studies p {
    margin-block-start: 0.375rem;
    max-width: var(--measure);
  }

  .small {
    font-size: 0.9375rem;
  }
</style>
