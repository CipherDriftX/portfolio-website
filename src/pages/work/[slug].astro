---
// /work/<file name>/: a project's page or a case study's page. Both live
// under Work; workPages() stops the build if one name is used for both.
import CaseStudy from "../../components/CaseStudy.astro";
import ProjectPage from "../../components/ProjectPage.astro";
import { workPages } from "../../lib/content";

export async function getStaticPaths() {
  const { studies, projects } = await workPages();
  return [
    ...studies.map((entry) => ({ params: { slug: entry.id }, props: { study: entry, project: undefined, projects } })),
    ...projects.map((entry) => ({ params: { slug: entry.id }, props: { study: undefined, project: entry, projects } })),
  ];
}

const { study, project, projects } = Astro.props;
---

{project ? <ProjectPage entry={project} all={projects} /> : study && <CaseStudy entry={study} />}
