---
// The site mark: a hypersonic jet seen from above, nose up, its leading edge
// one blended curve from nose to wingtip, the trailing edge a W that ends
// in two pointed engine tails. Two flat facets, lit from the
// right: bone and steel grey. Same drawing as the favicon and the jet hung
// in the hall. Decorative; the link around it carries the name.
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg class="mark" width={size * 0.625} height={size} viewBox="0 0 20 32" aria-hidden="true" focusable="false">
  <path fill="#8d9097" d="M10 0 C9 8 6.8 15 0.2 25.2 L0.2 27.6 L5.5 26.3 L6.7 31.4 L10 29.3Z"></path>
  <path fill="#ece7dc" d="M10 0 C11 8 13.2 15 19.8 25.2 L19.8 27.6 L14.5 26.3 L13.3 31.4 L10 29.3Z"></path>
</svg>
