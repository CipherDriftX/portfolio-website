---
// The site mark: a dark-brown square with one tungsten point, like the bulb
// in the photo. Same shape as the favicon. Decorative; the link around it
// carries the name.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg class="mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" rx="7" fill="#211413"></rect>
  <circle cx="22" cy="10" r="6" fill="#f7bc7c"></circle>
  <circle cx="22" cy="10" r="3.5" fill="#f6e9ce"></circle>
</svg>
