---
// The site mark: a hypersonic jet seen from above, nose up. Lit from the
// right, so one half sits a step darker (the faceted, stealth look); the
// tail runs into amber, the engine heat. Same drawing as the favicon.
// Decorative; the link around it carries the name.
interface Props {
  size?: number;
}
const { size = 28 } = Astro.props;
---

<svg class="mark" width={size * 0.625} height={size} viewBox="0 0 20 32" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="mark-r" x1="0" y1="0" x2="0" y2="32" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#fff7e8"/><stop offset=".5" stop-color="#f6e9ce"/><stop offset=".84" stop-color="#f7bc7c"/><stop offset="1" stop-color="#ee9b52"/></linearGradient><linearGradient id="mark-l" x1="0" y1="0" x2="0" y2="32" gradientUnits="userSpaceOnUse"><stop offset="0" stop-color="#e9dcc3"/><stop offset=".5" stop-color="#d9c6a6"/><stop offset=".84" stop-color="#d99a5f"/><stop offset="1" stop-color="#c97c3e"/></linearGradient>
  </defs>
  <path d="M10 0 Q8.85 7.5 7.65 15.6 L0.30 27.6 L0.30 29.1 L5.10 27.7 L6.30 31.9 L8.70 31.9 L10 29.9 Z" fill="url(#mark-l)"/><path d="M10 0 Q11.15 7.5 12.35 15.6 L19.70 27.6 L19.70 29.1 L14.90 27.7 L13.70 31.9 L11.30 31.9 L10 29.9 Z" fill="url(#mark-r)"/>
</svg>
