---
// One project card (home page and /work/): name, drawing, one line and up to
// two real numbers up front; how it works, the stack and the tool's own
// output fold under "How it works". The name opens the project's own page at
// /work/<file name>/. The first card in a lane is wide.
// GitHub icon: Bootstrap Icons 1.11.3, (c) 2019-2024 The Bootstrap Authors, MIT License,
// https://github.com/twbs/icons/blob/v1.11.3/LICENSE
import { render, type CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  wide?: boolean;
  /** The name's heading level: h4 under a lane's h3 on the home page, h3 on /work/. */
  level?: "h3" | "h4";
}
const { project, wide = false, level = "h4" } = Astro.props;
const Name = level;
const p = project.data;
const { Content } = await render(project);
const titleId = `project-${project.id}`;

// One drawing per project, made by _thumbs/make.py. Inlined so its labels
// use the site's own font.
const drawings = import.meta.glob<string>("./thumbs/*.svg", { query: "?raw", import: "default", eager: true });
const drawing = drawings[`./thumbs/${project.id}.svg`];
---

<article class:list={["card plate", { wide }]} aria-labelledby={titleId}>
  <header class="head">
    <Name id={titleId} class="name">
      <a href={`/work/${project.id}/`}>{p.name}</a>
      {p.draft && <span class="draft-tag">Draft</span>}
    </Name>
    <p class="meta">
      {p.context && <span>{p.context}</span>}
      <span class="num">{p.year}</span>
      <span>{p.language}</span>
    </p>
  </header>

  {drawing && <figure class="thumb" set:html={drawing} />}

  <div class="sum">
    <p class="line">{p.line}</p>
    {
      p.figures.length > 0 && (
        <ul role="list" class="figures">
          {p.figures.map((f) => (
            <li>
              <span class="value num">{f.value}</span>
              <span class="label">{f.label}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="foot">
    <details class="more">
      <summary>How it works</summary>
      <div class="detail">
        <div class="how"><Content /></div>
        <p class="stack"><span class="visually-hidden">Built with </span>{p.stack.join(" · ")}</p>
        {
          p.exhibit && (
            <figure class="exhibit">
              <pre tabindex="0" aria-label={`${p.name} output`}><code>{p.exhibit.text}</code></pre>
              <figcaption>{p.exhibit.caption}</figcaption>
            </figure>
          )
        }
      </div>
    </details>
    <a class="code" href={p.repo}>
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"></path></svg>
      <span>Code<span class="visually-hidden">: {p.name} on GitHub</span></span>
    </a>
  </div>
</article>

<style>
  /* A raised plate (global .plate) sitting over the lane's light. Its parts line up
     with the card beside it (subgrid rows: name, drawing, line, numbers,
     footer). Side padding matches the drawing's own margin (48 of 1200),
     measured on the card grid (.cards is the container: a card that is a
     container itself would lose its subgrid). */
  .card {
    --pad: max(1rem, 4cqi);
    display: grid;
    grid-row: span 5;
    grid-template-rows: subgrid;
    row-gap: 0;
    height: 100%;
  }

  .head,
  .line,
  .figures,
  .foot {
    padding-inline: var(--pad);
  }

  .head {
    padding-block-start: clamp(1.25rem, 1rem + 1vw, 1.75rem);
  }

  .name {
    margin: 0;
    font-family: var(--display);
    font-weight: 400;
    font-size: clamp(1.625rem, 1.35rem + 0.9vw, 2.125rem);
    line-height: 1;
    letter-spacing: -0.005em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .name a {
    text-decoration-color: transparent;
  }

  .name a:hover,
  .name a:focus-visible {
    text-decoration-color: var(--amber);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.875rem;
    margin-block-start: 0.5rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  /* The drawing runs edge to edge; its own plate colour drops so the
     card's light passes behind it. Every drawing is 1200 by 520, so the
     box keeps its exact size while the browser skips laying out its ~25
     text labels until it comes near the screen (most of the page's
     layout time at load, measured 2026-11-24). */
  .thumb {
    container-type: inline-size;
    margin: 0.5rem 0 0;
    aspect-ratio: 1200 / 520;
    content-visibility: auto;
  }

  .thumb :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .thumb :global(svg > rect:first-of-type) {
    fill: none;
  }

  /* A small drawing loses its notes and grows its step labels so they
     stay near 9 to 14px. */
  @container (max-width: 40rem) {
    .thumb :global(.minor) {
      display: none;
    }

    .thumb :global(.key) {
      font-size: 30px;
    }
  }

  .sum {
    display: contents;
  }

  .line {
    padding-block-start: 0.75rem;
    max-width: 40ch;
    font-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
    line-height: 1.45;
  }

  /* Numbers: large, plain, tabular. Each one is checkable in the repo. */
  .figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr));
    align-content: start;
    gap: 1.25rem 1.5rem;
    padding-block: 1.5rem 0.25rem;
  }

  .figures li {
    display: grid;
    align-content: start;
    gap: 0.5rem;
  }

  .value {
    font-size: clamp(1.875rem, 1.6rem + 1vw, 2.5rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.02em;
  }

  .label {
    max-width: 26ch;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  /* Footer: "How it works" opens below; the Code link sits on the same
     row at the right. */
  .foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-self: end;
    margin-block-start: 1.25rem;
    border-block-start: 1px solid var(--rule);
  }

  .more {
    grid-area: 1 / 1 / 2 / -1;
    min-width: 0;
  }

  summary {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: fit-content;
    min-height: 3rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.9375rem;
    font-weight: 600;
    transition: color 120ms ease-out;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* A plus that turns into a minus. */
  summary::after {
    content: "";
    width: 0.625rem;
    height: 0.625rem;
    background:
      linear-gradient(var(--amber), var(--amber)) center / 100% 1.5px no-repeat,
      linear-gradient(var(--amber), var(--amber)) center / 1.5px 100% no-repeat;
  }

  .more[open] summary::after {
    background: linear-gradient(var(--amber), var(--amber)) center / 100% 1.5px no-repeat;
  }

  summary:hover {
    color: var(--amber);
  }

  .detail {
    padding-block: 0.25rem 1.25rem;
  }

  .how {
    max-width: var(--measure);
  }

  .stack {
    margin-block-start: 0.875rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .code {
    grid-area: 1 / 2;
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 3rem;
    font-size: 0.9375rem;
    text-decoration: none;
  }

  .code span {
    text-decoration-line: underline;
    text-decoration-color: var(--amber);
    text-decoration-thickness: inherit;
    text-underline-offset: 0.28em;
  }

  .code svg {
    width: 1em;
    height: 1em;
    fill: var(--muted);
    transition: fill 120ms ease-out;
  }

  .code:hover svg {
    fill: var(--amber);
  }

  /* The tool's own output sits in a well cut into the card. */
  .exhibit {
    margin-block-start: 1.25rem;
    min-width: 0;
  }

  .exhibit pre {
    margin: 0;
    padding: 1rem 1.125rem;
    background: var(--base);
    box-shadow: inset 0 1px 0 rgb(0 0 0 / 0.6);
    color: var(--cream);
    font-family: ui-monospace, "SF Mono", "Cascadia Code", Menlo, Consolas, monospace;
    font-size: 0.75rem;
    line-height: 1.7;
    /* Terminal lines keep their shape; the well scrolls, never the page. */
    white-space: pre;
    overflow-x: auto;
    tab-size: 2;
    scrollbar-color: var(--wood) var(--base);
  }

  .exhibit figcaption {
    margin-block-start: 0.625rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  /* Two to a row: each card is half the grid. */
  @media (min-width: 48rem) {
    .card:not(.wide) {
      --pad: max(1rem, 2cqi);
    }
  }

  /* The lead card of a lane: its own grid, not tied to a neighbour. Wide
     screens put the drawing left and the line and numbers right. */
  .wide {
    grid-row: auto;
    grid-template-rows: none;
  }

  @media (min-width: 64rem) {
    .wide {
      /* The drawing column is 3/5 of the card, so its margin is 2.4% */
      --pad: max(1rem, 2.4cqi);
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      grid-template-areas:
        "head  head"
        "thumb sum"
        "foot  foot";
    }

    .wide .head {
      grid-area: head;
    }

    .wide .thumb {
      grid-area: thumb;
      margin-block: 0.75rem 0;
    }

    .wide .sum {
      grid-area: sum;
      display: block;
      align-self: center;
      padding-inline-end: var(--pad);
    }

    .wide .line,
    .wide .figures {
      padding-inline: 0;
    }

    .wide .line {
      font-size: clamp(1.1875rem, 1rem + 0.45vw, 1.375rem);
      line-height: 1.4;
    }

    .wide .name {
      font-size: clamp(2rem, 1.4rem + 1.6vw, 2.75rem);
    }

    .wide .foot {
      grid-area: foot;
    }
  }
</style>
