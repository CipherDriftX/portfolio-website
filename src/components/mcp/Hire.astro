---
// How to hire me, from src/content/hubs/mcp-servers.md, with a mail link.
import { site } from "../../data/site";

interface Props {
  hire: { lead: string; includes: string[] };
  /** The mail subject, e.g. the server the reader came from. */
  subject: string;
  id?: string;
  heading?: string;
}
const { hire, subject, id = "hire", heading = "Work with me" } = Astro.props;
const mail = `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
---

<section class="mcp-part" aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>{heading}</h2>
  <div class="mcp-body">
    <div class="mcp-hire plate">
      <p>{hire.lead}</p>
      <ul role="list">
        {hire.includes.map((item) => <li>{item}</li>)}
      </ul>
      <p>
        <a class="mail" href={mail}>Email me</a>
        <span class="quiet">{site.email}</span>
      </p>
    </div>
  </div>
</section>

<style>
  .mail {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-inline-end: 0.75rem;
    font-weight: 600;
  }
</style>
