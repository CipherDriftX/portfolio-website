---
import ContactLinks from "./ContactLinks.astro";
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<!-- The last bay closes the hall: its spot snaps on as it walks into view. -->
<footer class="contact" id="contact" aria-labelledby="contact-title">
  <div class="pool walk">
    <div class="frame">
      <h2 id="contact-title" class="wall">Contact</h2>
      <ContactLinks label="Contact" class="contact-row" />
      <p class="drone">{site.drone}</p>
    </div>
  </div>
  <p class="year frame"><span class="num">© {year}</span> {site.name}</p>
</footer>

<style>
  .contact {
    margin-block-start: var(--gap-hall);
  }

  .drone {
    margin-block-start: 1.5rem;
    color: var(--muted);
  }

  .year {
    padding-block: 1.75rem 2.5rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }
</style>
