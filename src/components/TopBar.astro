---
import Mark from "./Mark.astro";
import { site } from "../data/site";

interface Props {
  sections: { id: string; label: string; href: string; bar?: false }[];
  /** This page's path, to mark its own link. */
  path: string;
}
const { path } = Astro.props;
const sections = Astro.props.sections.filter((s) => s.bar !== false);
// The link for the page you are on, or the section it sits in (/work/wyatt/
// is in Work).
const here = (href: string) => !href.includes("#") && (path === href || path.startsWith(href));
// Phones keep the first two pages and Contact; the rest are in the footer.
const phoneHidden = (s: { id: string }, i: number) => s.id !== "contact" && i >= 2;
---

<header class="bar">
  <a class="home" href="/" aria-label={`${site.name}, home`}>
    <Mark />
  </a>
  {
    sections.length > 0 && (
      <nav aria-label="Sections">
        <ul role="list">
          {sections.map((s, i) => (
            <li class:list={{ wide: phoneHidden(s, i) }}>
              <a href={s.href} aria-current={here(s.href) ? "page" : undefined}>
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</header>

<style>
  .bar {
    position: absolute;
    inset: 0 0 auto;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    /* Line up with the page frame (82rem wide, centered). */
    padding: 0.75rem max(var(--gutter), calc((100% - 82rem) / 2 + var(--gutter)));
    isolation: isolate;
  }

  /* The links sit over the photo's ceiling bulbs. A soft fade of the page
     base keeps them readable (4.5:1 or better) without a visible bar. */
  .bar::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 6.5rem;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgb(11 8 7 / 0.86) 0,
      rgb(11 8 7 / 0.8) 3.75rem,
      rgb(11 8 7 / 0.45) 5rem,
      rgb(11 8 7 / 0) 100%
    );
  }

  .home {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    /* 44px hit area, 20px mark: pull back so the wingtip sits on the text edge. */
    margin-inline-start: -0.75rem;
    border-radius: 0.5rem;
  }

  ul {
    display: flex;
    gap: 0.25rem 1rem;
  }

  .wide {
    display: none;
  }

  @media (min-width: 48rem) {
    ul {
      gap: 0.25rem 1.5rem;
    }

    .wide {
      display: list-item;
    }
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    text-decoration-color: transparent;
  }

  nav a:hover {
    text-decoration-color: var(--amber);
  }

  /* The page you are on: a steady underline in the mark's tan, which is not
     the accent, so it reads as "here" and not as something to press. */
  nav a[aria-current="page"] {
    text-decoration-color: var(--tan);
  }

  nav a[aria-current="page"]:hover {
    text-decoration-color: var(--amber);
  }
</style>
