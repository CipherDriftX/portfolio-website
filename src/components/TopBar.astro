---
import Mark from "./Mark.astro";
import { site } from "../data/site";

interface Props {
  sections: { id: string; label: string }[];
  onHome?: boolean;
}
const { sections, onHome = false } = Astro.props;
const href = (id: string) => (onHome ? `#${id}` : `/#${id}`);
// Phones keep the first two sections and Contact; the rest are one scroll away.
const phoneHidden = (id: string, i: number) => id !== "contact" && i >= 2;
---

<header class="bar">
  {
    /* On the home page the jet hangs in the hall itself, so the bar leaves
       it out: one jet per room. */
    !onHome && (
      <a class="home" href="/" aria-label={`${site.name}, home`}>
        <Mark />
      </a>
    )
  }
  {
    sections.length > 0 && (
      <nav aria-label="Sections">
        <ul role="list">
          {sections.map((s, i) => (
            <li class:list={{ wide: phoneHidden(s.id, i) }}>
              <a href={href(s.id)}>{s.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</header>

<style>
  /* The hall's ceiling: mark left, section links right, on the dark. */
  .bar {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--bar);
    /* Line up with the page frame (82rem wide, centered). */
    padding-inline: max(var(--gutter), calc((100% - 82rem) / 2 + var(--gutter)));
  }

  .home {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    /* 44px hit area, 20px mark: pull back so the wingtip sits on the text edge. */
    margin-inline-start: -0.75rem;
    border-radius: 2px;
  }

  nav {
    margin-inline-start: auto;
  }

  ul {
    display: flex;
    gap: 0.25rem 1rem;
  }

  .wide {
    display: none;
  }

  @media (min-width: 48rem) {
    ul {
      gap: 0.25rem 1.75rem;
    }

    .wide {
      display: list-item;
    }
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration-color: transparent;
  }

  nav a:hover {
    text-decoration-color: var(--heat);
  }
</style>
