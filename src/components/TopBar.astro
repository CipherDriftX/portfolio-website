---
import Mark from "./Mark.astro";
import { site } from "../data/site";

interface Props {
  sections: { id: string; label: string }[];
  onHome?: boolean;
}
const { sections, onHome = false } = Astro.props;
const href = (id: string) => (onHome ? `#${id}` : `/#${id}`);
---

<header class="bar">
  <a class="home" href="/" aria-label={`${site.name}, home`}>
    <Mark />
  </a>
  {
    sections.length > 0 && (
      <nav aria-label="Sections">
        <ul role="list">
          {sections.map((s) => (
            <li>
              <a href={href(s.id)}>{s.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</header>

<style>
  .bar {
    position: absolute;
    inset: 0 0 auto;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    /* Line up with the page frame (82rem wide, centered). */
    padding: 0.75rem max(var(--gutter), calc((100% - 82rem) / 2 + var(--gutter)));
  }

  .home {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-inline-start: -0.5rem;
    border-radius: 0.5rem;
  }

  ul {
    display: flex;
    gap: 0.25rem 1.5rem;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    text-decoration-color: transparent;
  }

  nav a:hover {
    text-decoration-color: var(--amber);
  }
</style>
