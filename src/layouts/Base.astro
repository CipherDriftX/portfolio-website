---
import "../styles/global.css";
import TopBar from "../components/TopBar.astro";
import Contact from "../components/Contact.astro";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { site } from "../data/site";
import { homeLastmod } from "../lib/lastmod";
import { personId, personSchema, websiteId } from "../lib/schema";

interface Props {
  title: string;
  description: string;
  /** Path of this page, for the canonical URL. */
  path: string;
  sections?: { id: string; label: string; waiting?: boolean; href?: string; bar?: false }[];
  /** Add the ProfilePage + Person and WebSite schema (home page only). */
  person?: boolean;
  noindex?: boolean;
  ogType?: "website" | "article";
  /** The Contact block and footer. Off on the 404, which is one line and a link home. */
  contact?: boolean;
  /** The Contact heading and links above the footer. Off on /contact/, which is that page. */
  contactLinks?: boolean;
  /** schema.org fields for this page, e.g. an Article on case studies and notes. */
  schema?: Record<string, unknown>;
  /** This page's own link preview; the site photo card when left out. */
  image?: { path: string; alt: string };
  /** Where this page sits, home first, as a schema.org BreadcrumbList. */
  breadcrumbs?: { name: string; path: string }[];
  /** Code projects on this page, as schema.org SoftwareSourceCode by the Person. */
  code?: { name: string; description: string; repo: string; path: string; language: string; dateModified: string }[];
  /** More schema.org records that stand on their own, e.g. a Dataset (Google Dataset Search reads top-level ones). */
  extraSchema?: Record<string, unknown>[];
}

const {
  title,
  description,
  path,
  sections = [],
  person = false,
  noindex = false,
  ogType = "website",
  contact = true,
  contactLinks = true,
  schema,
  image,
  breadcrumbs,
  code = [],
  extraSchema = [],
} = Astro.props;

const canonical = new URL(path, site.url + "/").href;
const ogImage = image ? new URL(image.path, site.url).href : `${site.url}/og.jpg`;
const ogMime = image ? "image/png" : "image/jpeg";
const ogAlt = image
  ? image.alt
  : `${site.name} at a table by a window at night, next to the words: ${site.name}, ${site.title}. ${site.claim}`;

// Home: a profile page about one person (schema.org ProfilePage).
// Google's profile page markup wants full ISO 8601 date-times, not bare
// dates ("Invalid datetime value" in Search Console). The day is real; the
// time is set to midnight UTC.
const dateTime = (d: string) => (d.includes("T") ? d : `${d}T00:00:00+00:00`);

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${site.url}/#profile`,
  url: `${site.url}/`,
  name: title,
  inLanguage: "en",
  dateCreated: dateTime(site.launched),
  dateModified: dateTime(homeLastmod()),
  isPartOf: { "@id": websiteId },
  mainEntity: personSchema,
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": websiteId,
  name: site.name,
  url: `${site.url}/`,
  inLanguage: "en",
  publisher: { "@id": personId },
};

// Home and /work/: the projects, each one public code written by the Person,
// with its own page on this site.
const codeSchema = code.length > 0 && {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${canonical}#work`,
  name: `${site.name}: Work`,
  itemListElement: code.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "SoftwareSourceCode",
      name: c.name,
      description: c.description,
      codeRepository: c.repo,
      url: new URL(c.path, site.url + "/").href,
      programmingLanguage: c.language,
      dateModified: c.dateModified,
      author: { "@id": personId },
    },
  })),
};

// Where the page sits in the site, for search results that show a path.
const crumbSchema = breadcrumbs && {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbs.map((b, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: b.name,
    item: new URL(b.path, site.url + "/").href,
  })),
};

// The page's own record. A work on the page (an Article, a BlogPosting, a
// SoftwareSourceCode) gets its author; a page type (AboutPage, ContactPage,
// CollectionPage) is the page itself.
const isPageType = typeof schema?.["@type"] === "string" && /Page$/.test(schema["@type"] as string);
const pageSchema =
  schema &&
  (isPageType
    ? {
        "@context": "https://schema.org",
        "@id": `${canonical}#page`,
        name: title,
        description,
        inLanguage: "en",
        ...schema,
        url: canonical,
        isPartOf: { "@id": websiteId },
      }
    : {
        "@context": "https://schema.org",
        image: ogImage,
        inLanguage: "en",
        ...schema,
        url: canonical,
        mainEntityOfPage: canonical,
        isPartOf: schema.isPartOf ?? { "@id": websiteId },
        publisher: { "@id": personId },
        author: { "@type": "Person", "@id": personId, name: site.name, url: `${site.url}/` },
      });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0807" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="author" content={site.name} />
    <link rel="me" href={site.links.github} />
    <link rel="me" href={site.links.linkedin} />
    <link rel="me" href={site.links.x} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: Notes`} href={`${site.url}/rss.xml`} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <!-- For search results: Google does not read SVG and wants over 48 px. -->
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href="/fonts/gloock-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hanken-grotesk-var.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={ogMime} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {person && <script type="application/ld+json" set:html={JSON.stringify(profileSchema)} />}
    {person && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
    {codeSchema && <script type="application/ld+json" set:html={JSON.stringify(codeSchema)} />}
    {pageSchema && <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />}
    {crumbSchema && <script type="application/ld+json" set:html={JSON.stringify(crumbSchema)} />}
    {
      extraSchema.map((x) => (
        <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...x })} />
      ))
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <TopBar sections={sections} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {contact && <Contact sections={sections} links={contactLinks} />}
    <!-- Vercel Web Analytics: cookieless page views, about 1 KB, deferred. -->
    <Analytics />
    <!-- Vercel Speed Insights: real-visitor Core Web Vitals, deferred. -->
    <SpeedInsights />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
