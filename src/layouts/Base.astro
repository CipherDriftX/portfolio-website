---
import "../styles/global.css";
import TopBar from "../components/TopBar.astro";
import Contact from "../components/Contact.astro";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { site } from "../data/site";
import { homeLastmod } from "../lib/lastmod";

interface Props {
  title: string;
  description: string;
  /** Path of this page, for the canonical URL. */
  path: string;
  sections?: { id: string; label: string; waiting?: boolean }[];
  onHome?: boolean;
  /** Add the ProfilePage + Person and WebSite schema (home page only). */
  person?: boolean;
  noindex?: boolean;
  ogType?: "website" | "article";
  /** The Contact block and footer. Off on the 404, which is one line and a link home. */
  contact?: boolean;
  /** schema.org fields for this page, e.g. an Article on case studies and notes. */
  schema?: Record<string, unknown>;
  /** Code projects on this page, as schema.org SoftwareSourceCode by the Person. */
  code?: { name: string; description: string; repo: string; language: string; dateModified: string }[];
}

const {
  title,
  description,
  path,
  sections = [],
  onHome = false,
  person = false,
  noindex = false,
  ogType = "website",
  contact = true,
  schema,
  code = [],
} = Astro.props;

const canonical = new URL(path, site.url + "/").href;
const ogImage = `${site.url}/og.jpg`;
const ogAlt = `${site.name} at a table by a window at night, next to the words: ${site.name}, ${site.title}. ${site.claim}`;

// One id per thing, so search engines and AI answers read the site, its
// pages and the person as one connected record.
const personId = `${site.url}/#person`;
const websiteId = `${site.url}/#website`;

const personSchema = {
  "@type": "Person",
  "@id": personId,
  name: site.name,
  jobTitle: site.title,
  description: site.claim,
  url: `${site.url}/`,
  image: `${site.url}${site.photo.schema}`,
  email: `mailto:${site.email}`,
  sameAs: [site.links.linkedin, site.links.github],
  knowsAbout: site.topics,
};

// Home: a profile page about one person (schema.org ProfilePage).
const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": `${site.url}/#profile`,
  url: `${site.url}/`,
  name: title,
  inLanguage: "en",
  dateModified: homeLastmod(),
  isPartOf: { "@id": websiteId },
  mainEntity: personSchema,
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": websiteId,
  name: site.name,
  url: `${site.url}/`,
  inLanguage: "en",
  publisher: { "@id": personId },
};

// Home: the projects in Work, each one public code written by the Person.
const codeSchema = code.length > 0 && {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${canonical}#work`,
  name: `${site.name}: Work`,
  itemListElement: code.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "SoftwareSourceCode",
      name: c.name,
      description: c.description,
      codeRepository: c.repo,
      url: c.repo,
      programmingLanguage: c.language,
      dateModified: c.dateModified,
      author: { "@id": personId },
    },
  })),
};

// Case studies and notes: the page's own Article, written by the Person.
const pageSchema = schema && {
  "@context": "https://schema.org",
  image: ogImage,
  inLanguage: "en",
  ...schema,
  url: canonical,
  isPartOf: { "@id": websiteId },
  author: { "@type": "Person", "@id": personId, name: site.name, url: `${site.url}/` },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0807" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href="/fonts/gloock-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hanken-grotesk-var.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {person && <script type="application/ld+json" set:html={JSON.stringify(profileSchema)} />}
    {person && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
    {codeSchema && <script type="application/ld+json" set:html={JSON.stringify(codeSchema)} />}
    {pageSchema && <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <TopBar sections={sections} onHome={onHome} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {contact && <Contact />}
    <!-- Vercel Web Analytics: cookieless page views, about 1 KB, deferred. -->
    <Analytics />
    <!-- Vercel Speed Insights: real-visitor Core Web Vitals, deferred. -->
    <SpeedInsights />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
