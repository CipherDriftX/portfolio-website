---
// The site's own pages: /work/, /work/<project>/, /about/, /contact/, /cv/
// and the /mcp-servers/ section.
// Same room as the reading pages: one tungsten light from above, a quiet
// way back, then the page's own h1 and content.
import Base from "./Base.astro";
import { siteContent } from "../lib/content";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  path: string;
  /** Where the quiet link above the title goes. Home by default. */
  back?: { href: string; label: string };
  draft?: boolean;
  schema?: Record<string, unknown>;
  image?: { path: string; alt: string };
  breadcrumbs?: { name: string; path: string }[];
  code?: { name: string; description: string; repo: string; path: string; language: string; dateModified: string }[];
  /** The Contact heading and links above the footer. */
  contactLinks?: boolean;
  extraSchema?: Record<string, unknown>[];
}
const { back = { href: "/", label: site.name }, draft = false, ...rest } = Astro.props;
const { sections } = await siteContent();
---

<Base {...rest} sections={sections}>
  <div class="glow" aria-hidden="true"></div>
  <div class="page frame">
    <a class="back" href={back.href}>{back.label}</a>
    {draft && <p class="draft-tag">Draft: hidden in production</p>}
    <slot />
  </div>
</Base>

<style>
  .page {
    position: relative;
    z-index: 1;
    padding-block-start: clamp(6rem, 4rem + 6vw, 9rem);
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .back:hover {
    color: var(--amber);
  }

  .page > :global(.draft-tag) {
    display: block;
    width: fit-content;
    margin: 1rem 0 0;
  }

  /* The page title and the line under it, the same on every page here. */
  .page :global(.page-title) {
    margin-block-start: 1.5rem;
    font-size: clamp(2.75rem, 1.9rem + 3.75vw, 5rem);
    line-height: 1;
    letter-spacing: -0.005em;
  }

  .page :global(.page-lead) {
    max-width: 34ch;
    margin-block-start: 1.25rem;
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.625rem);
    line-height: 1.4;
  }
</style>
