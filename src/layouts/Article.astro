---
// Reading pages: case studies and notes. The header stands in a lit pool;
// the text is read on the dark floor below it.
import Base from "./Base.astro";
import { siteContent } from "../lib/content";

interface Props {
  title: string;
  description: string;
  path: string;
  back: { href: string; label: string };
  draft?: boolean;
}
const { title, description, path, back, draft = false } = Astro.props;
const { sections } = await siteContent();
---

<Base title={title} description={description} path={path} sections={sections} ogType="article">
  <article class="article">
    <div class="pool head-pool">
      <div class="frame">
        <a class="back" href={back.href}>{back.label}</a>
        {draft && <p class="draft-tag">Draft: hidden in production</p>}
        <slot name="header" />
      </div>
    </div>
    <div class="frame">
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Base>

<style>
  .head-pool {
    padding-block-start: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .back {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .back:hover {
    color: var(--heat);
  }

  .head-pool :global(.draft-tag) {
    display: block;
    width: fit-content;
    margin: 1rem 0 0;
  }

  /* Long-form body */
  .prose {
    max-width: var(--measure);
    margin-block-start: clamp(3rem, 2rem + 3vw, 5rem);
    font-size: 1.125rem;
    line-height: 1.65;
  }

  .prose :global(> * + *) {
    margin-block-start: 1.1em;
  }

  .prose :global(h2) {
    margin-block-start: 2.4em;
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
  }

  .prose :global(h3) {
    margin-block-start: 2em;
    font-family: var(--text);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .prose :global(h2 + *),
  .prose :global(h3 + *) {
    margin-block-start: 0.6em;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: 1.25em;
  }

  .prose :global(li + li) {
    margin-block-start: 0.4em;
  }

  .prose :global(li::marker) {
    color: var(--muted);
  }

  .prose :global(blockquote) {
    /* Upright: only the roman Hanken file loads, so italic would be faked. */
    padding-inline-start: 1.25em;
    color: var(--muted);
  }

  .prose :global(code) {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.875em;
  }

  .prose :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    background: var(--pool);
    border-radius: 2px;
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 1.25rem;
    background: var(--pool) !important;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 1rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.5rem 0.75rem 0.5rem 0;
    text-align: start;
  }

  /* Rows read by alternate light, not by rules. */
  .prose :global(tbody tr:nth-child(odd)) {
    background: var(--pool);
  }

  .prose :global(img) {
    height: auto;
  }
</style>
